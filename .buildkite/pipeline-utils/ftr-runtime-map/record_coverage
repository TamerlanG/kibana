const path = require('path');
const fs = require('fs');
const { spawnSync } = require('child_process');
const parseArgs = require('minimist');

require('ts-node').register({
  transpileOnly: true,
  compilerOptions: {
    module: 'commonjs',
  },
  project: path.join(__dirname, '../../tsconfig.json'),
});

const { getKibanaDir } = require(path.join(__dirname, '../utils'));
const { summarizeFtrCoverage } = require(path.join(__dirname, './summarize'));
const { printSummary, writeDetailJson } = require(path.join(__dirname, './report'));

const HELP_TEXT = `
Usage: record_coverage <ftr-config-path> [options]

Record which @kbn/ modules an FTR config exercises at runtime. Runs the config
twice with NODE_V8_COVERAGE — a normal test run, then a --dry-run boot
baseline — and prints the modules whose functions executed only in the test
run. Takes roughly two full FTR runs of the config (~10 min for a small one).

Options:
  --out-dir <dir>             Working directory for dumps and results
                              (default: <repo>/target/ftr-runtime-map/<config-slug>)
  --json <file>               Detail JSON path (default: <out-dir>/packages.json)
  --kibana-install-dir <dir>  Run FTR against a built Kibana distribution instead
                              of from source (same flag as functional_tests; what
                              CI uses, and required locally for browser configs
                              that need dist bundles). Applied to both the test
                              run and the baseline so the two stay comparable.
  --keep-raw                  Keep raw V8 dumps (~hundreds of MB) after summarizing
  --help, -h                  Show this help message

Example:
  record_coverage src/platform/test/api_integration/apis/unused_urls_task/config.ts
`.trim();

function runFtr(kibanaDir, configPath, coverageDir, extraArgs) {
  const args = ['scripts/functional_tests', '--config', configPath, ...extraArgs];
  const result = spawnSync('node', args, {
    cwd: kibanaDir,
    stdio: 'inherit',
    env: { ...process.env, NODE_V8_COVERAGE: coverageDir },
  });
  if (result.error) {
    throw new Error(`failed to spawn functional_tests: ${result.error.message}`);
  }
  if (result.status !== 0) {
    const exit = result.signal ? `signal ${result.signal}` : `status ${result.status}`;
    throw new Error(`functional_tests ${extraArgs.join(' ')} exited with ${exit}`.trim());
  }
}

/** Reject typo'd flags instead of silently ignoring them (runs here cost ~20 min). */
function rejectUnknownFlags(arg) {
  if (arg.startsWith('-')) {
    console.error(`Unknown flag: ${arg}\n`);
    console.log(HELP_TEXT);
    process.exit(1);
  }
  return true;
}

/** minimist turns repeated flags into arrays; keep the last occurrence. */
function lastValue(value) {
  return Array.isArray(value) ? value[value.length - 1] : value;
}

function main() {
  const argv = parseArgs(process.argv.slice(2), {
    boolean: ['help', 'keep-raw'],
    string: ['out-dir', 'json', 'kibana-install-dir'],
    alias: { h: 'help' },
    unknown: rejectUnknownFlags,
  });

  if (argv.help || argv._.length !== 1) {
    console.log(HELP_TEXT);
    process.exit(argv.help ? 0 : 1);
  }

  const configPath = argv._[0];
  const kibanaDir = getKibanaDir();
  const slug = configPath.replace(/[/.]/g, '_');
  // Resolve to absolute paths: NODE_V8_COVERAGE is resolved by the FTR child
  // process against ITS cwd (the repo root), while this process resolves
  // against the user's cwd — relative paths would split the two.
  const outDir = path.resolve(
    lastValue(argv['out-dir']) || path.join(kibanaDir, 'target', 'ftr-runtime-map', slug)
  );
  const jsonPath = path.resolve(lastValue(argv.json) || path.join(outDir, 'packages.json'));
  const runDir = path.join(outDir, 'test-run');
  const baselineDir = path.join(outDir, 'baseline');

  const rawInstallDir = lastValue(argv['kibana-install-dir']);
  const installDir = rawInstallDir ? path.resolve(rawInstallDir) : undefined;
  if (installDir && !fs.existsSync(installDir)) {
    console.error(`--kibana-install-dir does not exist: ${installDir}`);
    process.exit(1);
  }
  // Both runs get the same install dir: run and baseline must come from the
  // same build for the function-key subtraction to be valid.
  const commonArgs = installDir ? ['--kibana-install-dir', installDir] : [];

  try {
    for (const dir of [runDir, baselineDir]) {
      fs.rmSync(dir, { recursive: true, force: true });
      fs.mkdirSync(dir, { recursive: true });
    }

    console.error(`==> [1/3] recording test run: ${configPath}`);
    runFtr(kibanaDir, configPath, runDir, [...commonArgs]);

    console.error('==> [2/3] recording boot baseline (--dry-run, no tests)');
    runFtr(kibanaDir, configPath, baselineDir, [...commonArgs, '--dry-run']);

    console.error('==> [3/3] subtracting baseline and summarizing');
    const summary = summarizeFtrCoverage({ runDir, baselineDir });
    printSummary(summary);
    writeDetailJson(summary, jsonPath);

    if (!argv['keep-raw']) {
      fs.rmSync(runDir, { recursive: true, force: true });
      fs.rmSync(baselineDir, { recursive: true, force: true });
      console.error('raw V8 dumps deleted (pass --keep-raw to keep them)');
    } else {
      console.error(`raw V8 dumps kept in ${outDir}`);
    }
    process.exit(0);
  } catch (error) {
    console.error('Error recording coverage:', error.message);
    process.exit(1);
  }
}

main();

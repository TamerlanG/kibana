const path = require('path');
const fs = require('fs');
const { spawnSync } = require('child_process');
const parseArgs = require('minimist');

require('ts-node').register({
  transpileOnly: true,
  compilerOptions: {
    module: 'commonjs',
  },
  project: path.join(__dirname, '../../tsconfig.json'),
});

const { getKibanaDir } = require(path.join(__dirname, '../utils'));
const { findModuleForPath } = require(path.join(__dirname, '../affected-packages'));
const { summarizeFtrCoverage } = require(path.join(__dirname, './summarize'));
const { printSummary, writeDetailJson } = require(path.join(__dirname, './report'));
const { runScoutComparison, printScoutComparison } = require(path.join(
  __dirname,
  './compare_scout'
));

const HELP_TEXT = `
Usage: record_coverage <config-path> [options]

Record which @kbn/ modules a test config exercises at runtime. Runs the config
twice — a normal test run, then a boot baseline (no tests) — and prints the
modules whose functions executed only in the test run. Node processes (test
runner + Kibana server) are recorded via NODE_V8_COVERAGE; for UI configs the
Chrome side is recorded too and reported as a separate "browser modules" table.

Supports both FTR and Scout configs (auto-detected from the config path):
  FTR:   .../test/**/config.(ts|js)          → functional_tests
         (baseline: --dry-run for API configs; for UI configs a login+home+idle
          run of the same servers, so browser registration noise is subtracted)
  Scout: .../test/scout*/**/playwright.config.ts → scout run-tests
         (baseline: start-server for API configs; blank-page run for UI configs,
          booting the target's server config set)

Takes roughly two full runs of the config (~10 min for a small one).

Options:
  --out-dir <dir>             Working directory for dumps and results
                              (default: <repo>/target/ftr-runtime-map/<config-slug>)
  --json <file>               Detail JSON path (default: <out-dir>/packages.json)
  --kibana-install-dir <dir>  Run against a built Kibana distribution instead of
                              from source (recommended for UI configs). Applied to
                              both the test run and the baseline so the two stay
                              comparable.
  --arch <arch>               (Scout only) Server architecture [default: stateful]
  --domain <domain>           (Scout only) Server domain [default: classic]
  --keep-raw                  Keep raw V8 dumps (~hundreds of MB) after summarizing
  --help, -h                  Show this help message

Examples:
  record_coverage src/platform/test/api_integration/apis/unused_urls_task/config.ts
  record_coverage x-pack/platform/plugins/shared/embeddable_alerts_table/test/scout/ui/playwright.config.ts
`.trim();

const SCOUT_CONFIG_RE = /\/test\/scout[^/]*\/.*playwright\.config\.ts$/;
const SCOUT_UI_CONFIG_RE = /\/test\/scout[^/]*\/ui\//;

// Blank-page baseline config: logs in + loads a Kibana page + idles, so the
// baseline captures the plugin-registration coverage every UI test triggers on
// page load. Uses the 'default' server config set (path contains /test/scout/);
// custom-config-set targets get a generated sibling config instead — see
// runScoutUiBaseline.
const SCOUT_UI_BASELINE_CONFIG =
  'src/platform/packages/shared/kbn-scout/test/scout/ui/baseline.playwright.config.ts';
const SCOUT_UI_BASELINE_TEST_DIR =
  'src/platform/packages/shared/kbn-scout/test/scout/ui/baseline_tests';

// FTR equivalent of the Scout UI baseline: a wrapper config that boots the
// TARGET config's servers (via FTR_BASELINE_TARGET_CONFIG) but runs a single
// login + home + idle spec, capturing the browser registration noise a
// --dry-run baseline (which never opens a browser) cannot.
const FTR_UI_BASELINE_CONFIG = 'src/platform/test/coverage_baseline/config.ts';

/**
 * Scout server config set: configs under `.../test/scout_<name>/...` use the
 * `<name>` config set; everything else uses `default`. Mirrors Scout's
 * `detectCustomConfigDir` (`kbn-scout/src/servers/configs/utils/detect_custom_config.ts`).
 */
function deriveServerConfigSet(configPath) {
  const m = configPath.match(/\/test\/scout_([^/]+)\//);
  return m ? m[1] : 'default';
}

function spawnNode(kibanaDir, args, coverageDir, extraEnv, label) {
  const result = spawnSync('node', args, {
    cwd: kibanaDir,
    stdio: 'inherit',
    env: { ...process.env, NODE_V8_COVERAGE: coverageDir, ...extraEnv },
  });
  if (result.error) {
    throw new Error(`failed to spawn ${label}: ${result.error.message}`);
  }
  if (result.status !== 0) {
    const exit = result.signal ? `signal ${result.signal}` : `status ${result.status}`;
    throw new Error(`${label} exited with ${exit}`);
  }
}

function runFtr(kibanaDir, configPath, coverageDir, { installDir, dryRun }) {
  const args = ['scripts/functional_tests', '--config', configPath];
  if (installDir) args.push('--kibana-install-dir', installDir);
  if (dryRun) args.push('--dry-run');
  spawnNode(
    kibanaDir,
    args,
    coverageDir,
    // FTR_BROWSER_COVERAGE_DIR makes the FTR webdriver layer record Chrome via CDP
    { FTR_BROWSER_COVERAGE_DIR: coverageDir },
    `functional_tests${dryRun ? ' --dry-run' : ''}`
  );
}

/** True when the test run opened a browser (i.e. this is a UI config). */
function hasBrowserDumps(coverageDir) {
  return fs.readdirSync(coverageDir).some((f) => f.startsWith('coverage-browser-'));
}

/**
 * Baseline for an FTR UI config: run the wrapper config, which extends the
 * target config (same servers) but only logs in, loads home, and idles —
 * capturing the browser plugin-registration noise every page load triggers
 * plus the server boot/per-request noise. A --dry-run baseline cannot do this
 * because it never opens a browser.
 */
function runFtrUiBaseline(kibanaDir, targetConfigPath, coverageDir, { installDir }) {
  const args = ['scripts/functional_tests', '--config', FTR_UI_BASELINE_CONFIG];
  if (installDir) args.push('--kibana-install-dir', installDir);
  spawnNode(
    kibanaDir,
    args,
    coverageDir,
    {
      FTR_BROWSER_COVERAGE_DIR: coverageDir,
      FTR_BASELINE_TARGET_CONFIG: path.resolve(kibanaDir, targetConfigPath),
    },
    'functional_tests (browser baseline)'
  );
}

function runScout(kibanaDir, configPath, coverageDir, { installDir, arch, domain }) {
  const args = [
    'scripts/scout',
    'run-tests',
    '--location',
    'local',
    '--arch',
    arch,
    '--domain',
    domain,
    '--config',
    configPath,
  ];
  if (installDir) args.push('--kibanaInstallDir', installDir);
  spawnNode(
    kibanaDir,
    args,
    coverageDir,
    // SCOUT_BROWSER_COVERAGE_DIR arms the Playwright coverage fixture; disable the
    // reporter so its own node process doesn't add noise/latency.
    { SCOUT_BROWSER_COVERAGE_DIR: coverageDir, SCOUT_REPORTER_ENABLED: 'false' },
    'scout run-tests'
  );
}

function runScoutServerBaseline(kibanaDir, configPath, coverageDir, { installDir, arch, domain }) {
  const args = [
    'scripts/scout',
    'start-server',
    '--location',
    'local',
    '--arch',
    arch,
    '--domain',
    domain,
    '--serverConfigSet',
    deriveServerConfigSet(configPath),
    '--exitAfterReady',
  ];
  if (installDir) args.push('--kibanaInstallDir', installDir);
  // no browser dir: start-server never launches a browser
  spawnNode(kibanaDir, args, coverageDir, {}, 'scout start-server --exitAfterReady');
}

/**
 * Baseline for a Scout UI config: run the blank-page baseline config through the
 * normal test runner so it captures BOTH the server boot/per-request platform
 * code AND the browser plugin-registration coverage that every page load
 * triggers. Subtracting this removes the "every UI plugin registers on load"
 * noise a plain start-server baseline cannot.
 *
 * Scout derives the server config set from the CONFIG PATH (`/test/scout_<name>/`
 * → the `<name>` set), so for custom-set targets the shared baseline config
 * (default set) would boot the wrong servers. Instead, generate a throwaway
 * config NEXT TO the target — same path-based detection, same servers —
 * pointing at the shared baseline spec, and delete it after the run.
 */
function runScoutUiBaseline(kibanaDir, targetConfigPath, coverageDir, opts) {
  if (deriveServerConfigSet(targetConfigPath) === 'default') {
    runScoutUiBaselineConfig(kibanaDir, SCOUT_UI_BASELINE_CONFIG, coverageDir, opts);
    return;
  }

  const targetDir = path.dirname(path.resolve(kibanaDir, targetConfigPath));
  const tempConfigPath = path.join(targetDir, 'coverage_baseline.playwright.config.ts');
  fs.writeFileSync(
    tempConfigPath,
    [
      '// GENERATED by .buildkite/pipeline-utils/ftr-runtime-map/record_coverage;',
      '// lives next to the target config so Scout boots the same server config set.',
      '// Deleted after the baseline run — do not commit.',
      "import { createPlaywrightConfig } from '@kbn/scout';",
      '',
      'export default createPlaywrightConfig({',
      `  testDir: ${JSON.stringify(path.resolve(kibanaDir, SCOUT_UI_BASELINE_TEST_DIR))},`,
      '});',
      '',
    ].join('\n')
  );
  try {
    runScoutUiBaselineConfig(kibanaDir, tempConfigPath, coverageDir, opts);
  } finally {
    fs.rmSync(tempConfigPath, { force: true });
  }
}

function runScoutUiBaselineConfig(kibanaDir, configPath, coverageDir, { installDir, arch, domain }) {
  const args = [
    'scripts/scout',
    'run-tests',
    '--location',
    'local',
    '--arch',
    arch,
    '--domain',
    domain,
    '--config',
    configPath,
  ];
  if (installDir) args.push('--kibanaInstallDir', installDir);
  spawnNode(
    kibanaDir,
    args,
    coverageDir,
    { SCOUT_BROWSER_COVERAGE_DIR: coverageDir, SCOUT_REPORTER_ENABLED: 'false' },
    'scout run-tests (browser baseline)'
  );
}

/** Reject typo'd flags instead of silently ignoring them (runs here cost ~20 min). */
function rejectUnknownFlags(arg) {
  if (arg.startsWith('-')) {
    console.error(`Unknown flag: ${arg}\n`);
    console.log(HELP_TEXT);
    process.exit(1);
  }
  return true;
}

/** minimist turns repeated flags into arrays; keep the last occurrence. */
function lastValue(value) {
  return Array.isArray(value) ? value[value.length - 1] : value;
}

function main() {
  const argv = parseArgs(process.argv.slice(2), {
    boolean: ['help', 'keep-raw'],
    string: ['out-dir', 'json', 'kibana-install-dir', 'arch', 'domain'],
    alias: { h: 'help' },
    unknown: rejectUnknownFlags,
  });

  if (argv.help || argv._.length !== 1) {
    console.log(HELP_TEXT);
    process.exit(argv.help ? 0 : 1);
  }

  const configPath = argv._[0];
  const isScout = SCOUT_CONFIG_RE.test(configPath);
  const kibanaDir = getKibanaDir();
  const slug = configPath.replace(/[/.]/g, '_');
  // Resolve to absolute paths: NODE_V8_COVERAGE is resolved by the child process
  // against ITS cwd (the repo root), while this process resolves against the
  // user's cwd — relative paths would split the two.
  const outDir = path.resolve(
    lastValue(argv['out-dir']) || path.join(kibanaDir, 'target', 'ftr-runtime-map', slug)
  );
  const jsonPath = path.resolve(lastValue(argv.json) || path.join(outDir, 'packages.json'));
  const runDir = path.join(outDir, 'test-run');
  const baselineDir = path.join(outDir, 'baseline');

  const rawInstallDir = lastValue(argv['kibana-install-dir']);
  const installDir = rawInstallDir ? path.resolve(rawInstallDir) : undefined;
  if (installDir && !fs.existsSync(installDir)) {
    console.error(`--kibana-install-dir does not exist: ${installDir}`);
    process.exit(1);
  }
  const scoutOpts = {
    installDir,
    arch: lastValue(argv.arch) || 'stateful',
    domain: lastValue(argv.domain) || 'classic',
  };

  try {
    for (const dir of [runDir, baselineDir]) {
      fs.rmSync(dir, { recursive: true, force: true });
      fs.mkdirSync(dir, { recursive: true });
    }

    console.error(`==> [1/3] recording test run (${isScout ? 'scout' : 'ftr'}): ${configPath}`);
    if (isScout) {
      runScout(kibanaDir, configPath, runDir, scoutOpts);
    } else {
      runFtr(kibanaDir, configPath, runDir, { installDir });
    }

    console.error('==> [2/3] recording boot baseline (no tests)');
    if (isScout && SCOUT_UI_CONFIG_RE.test(configPath)) {
      // UI config: blank-page baseline captures browser registration + server per-request noise
      runScoutUiBaseline(kibanaDir, configPath, baselineDir, scoutOpts);
    } else if (isScout) {
      // API config: no browser, a server-only boot baseline is enough
      runScoutServerBaseline(kibanaDir, configPath, baselineDir, scoutOpts);
    } else if (hasBrowserDumps(runDir)) {
      // FTR UI config (the test run recorded Chrome coverage): boot the same
      // servers with a login + home + idle spec so the baseline captures the
      // browser registration noise. Fall back to the server-only --dry-run
      // baseline when the wrapper cannot run this config (e.g. no home app).
      try {
        runFtrUiBaseline(kibanaDir, configPath, baselineDir, { installDir });
      } catch (error) {
        console.error(
          `\n⚠️  FTR browser baseline failed (${error.message}); falling back to the ` +
            'server-only --dry-run baseline — browser rows will include page-load registration noise.\n'
        );
        runFtr(kibanaDir, configPath, baselineDir, { installDir, dryRun: true });
      }
    } else {
      runFtr(kibanaDir, configPath, baselineDir, { installDir, dryRun: true });
    }

    console.error('==> [3/3] subtracting baseline and summarizing');
    const summary = summarizeFtrCoverage({ runDir, baselineDir });

    // Guard against a broken baseline (e.g. a SIGKILLed server that never flushed
    // coverage): with no baseline, subtraction is a no-op and every boot-loaded
    // module looks test-exercised.
    if (!summary.totalBaselineFunctions) {
      console.error(
        '\n⚠️  baseline recorded 0 functions — subtraction is a no-op and results include boot noise.\n' +
          '   The server likely did not flush coverage on shutdown.\n'
      );
    }

    printSummary(summary);
    writeDetailJson(summary, jsonPath);

    // For Scout configs, also compare runtime coverage against Scout's static
    // selection (upstream dependency closure + implicit-consumer overlay).
    if (isScout) {
      try {
        const owningModule = findModuleForPath(configPath);
        if (!owningModule || owningModule.startsWith('[')) {
          console.error(`\nskipping static comparison: no owning module for ${configPath}`);
        } else {
          console.error('\n==> comparing runtime coverage against static selection');
          printScoutComparison(
            runScoutComparison({
              owningModule,
              runtimeServer: new Set(summary.rows.map((r) => r.moduleId)),
              runtimeBrowser: new Set(summary.browserRows.map((r) => r.moduleId)),
            })
          );
        }
      } catch (error) {
        console.error(`\nstatic comparison failed (non-fatal): ${error.message}`);
      }
    }

    if (!argv['keep-raw']) {
      fs.rmSync(runDir, { recursive: true, force: true });
      fs.rmSync(baselineDir, { recursive: true, force: true });
      console.error('raw V8 dumps deleted (pass --keep-raw to keep them)');
    } else {
      console.error(`raw V8 dumps kept in ${outDir}`);
    }
    process.exit(0);
  } catch (error) {
    console.error('Error recording coverage:', error.message);
    process.exit(1);
  }
}

main();

// Standalone re-analysis of an ALREADY-RECORDED Scout run: compares a saved
// packages.json against static selection without re-running the tests.
// `record_coverage` runs this comparison automatically for Scout configs, so
// this CLI is only needed to re-crunch old dumps.

const path = require('path');
const fs = require('fs');
const parseArgs = require('minimist');

require('ts-node').register({
  transpileOnly: true,
  compilerOptions: {
    module: 'commonjs',
  },
  project: path.join(__dirname, '../../tsconfig.json'),
});

const { findModuleForPath } = require(path.join(__dirname, '../affected-packages'));
const { runScoutComparison, printScoutComparison } = require(path.join(
  __dirname,
  './compare_scout'
));

const HELP_TEXT = `
Usage: compare_scout_selection --config <scout-config> --runtime-json <packages.json> [options]

Re-compare a saved Scout runtime coverage file (from record_coverage) against
Scout's static selective testing. record_coverage does this automatically for
Scout configs; use this only to re-analyze existing dumps.

Options:
  --config <path>        Scout playwright.config.ts (its owning module = static M)
  --runtime-json <path>  record_coverage packages.json (repeatable; unioned)
  --module <id>          Override the owning module (else derived from --config)
  --out <file>           Write the full JSON report
  --help, -h             Show this help message
`.trim();

function readRuntimeJson(files) {
  const server = new Set();
  const browser = new Set();
  for (const file of files) {
    const data = JSON.parse(fs.readFileSync(file, 'utf8'));
    const serverMap = data.server || data;
    const browserMap = data.browser || {};
    for (const mod of Object.keys(serverMap)) server.add(mod);
    for (const mod of Object.keys(browserMap)) browser.add(mod);
  }
  return { server, browser };
}

function main() {
  const argv = parseArgs(process.argv.slice(2), {
    boolean: ['help'],
    string: ['config', 'runtime-json', 'module', 'out'],
    alias: { h: 'help' },
  });

  if (argv.help || !argv.config || !argv['runtime-json']) {
    console.log(HELP_TEXT);
    process.exit(argv.help ? 0 : 1);
  }

  const owningModule = argv.module || findModuleForPath(argv.config);
  if (!owningModule || owningModule.startsWith('[')) {
    console.error(`Could not resolve owning module for config: ${argv.config}`);
    console.error('Pass --module <@kbn/...> explicitly.');
    process.exit(1);
  }

  try {
    const { server, browser } = readRuntimeJson([].concat(argv['runtime-json']).filter(Boolean));
    const report = runScoutComparison({
      owningModule,
      runtimeServer: server,
      runtimeBrowser: browser,
    });
    printScoutComparison(report);

    if (argv.out) {
      fs.mkdirSync(path.dirname(path.resolve(argv.out)), { recursive: true });
      fs.writeFileSync(path.resolve(argv.out), JSON.stringify(report, null, 2));
      console.error(`\nwrote ${argv.out}`);
    }
    process.exit(0);
  } catch (error) {
    console.error('Error comparing selection:', error.message);
    process.exit(1);
  }
}

main();
